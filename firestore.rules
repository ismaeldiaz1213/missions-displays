rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins: any verified Google account on the church domains.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[^@]+@iblibertad[.](org|com)$');
    }

    function str(v, max) { return v is string && v.size() <= max; }
    function reqStr(v, max) { return str(v, max) && v.size() > 0; }

    // ── Missionaries: public read, admin write ────────────────────────────────
    match /missionaries/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kiosk display settings (e.g. which conference stage the map shows): public read, admin write
    match /settings/kiosk {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['conferencePhase', 'updatedAt'])
        && request.resource.data.conferencePhase in ['auto', 'upcoming', 'live', 'over']
        && request.resource.data.updatedAt == request.time;
    }

    // Hotel names/colors and which registration stays where. Admin only: assignments are keyed
    // by registration id.
    match /settings/hotels {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['hotels', 'assignments', 'updatedAt'])
        && request.resource.data.hotels is list && request.resource.data.hotels.size() <= 20
        && request.resource.data.assignments is map
        && request.resource.data.updatedAt == request.time;
    }

    // Unpublished missionary pages (created from approved requests)
    match /missionaryDrafts/{id} {
      allow read, write: if isAdmin();
    }

    // ── Missionary self-edits (private edit link sent to the missionary) ─────
    // The document id is the secret token in the link: anyone holding it may read that one
    // document (never list them) and save or submit their proposed page. Only admins create
    // links, review, approve or reject. See src/data/missionaryEdits.ts.
    function validLocation(l) {
      return l is map
        && l.keys().hasOnly(['city', 'state', 'country', 'latitude', 'longitude'])
        && reqStr(l.city, 200) && str(l.get('state', ''), 200) && reqStr(l.country, 200)
        && l.latitude is number && l.latitude >= -90 && l.latitude <= 90
        && l.longitude is number && l.longitude >= -180 && l.longitude <= 180;
    }

    // A stored file: empty, already public, or uploaded with this edit link.
    function editFile(path, token, kind, publicFolder) {
      return str(path, 500)
        && (path == '' || path.matches('^' + publicFolder + '/[^/]+$')
            || path.matches('^missionary-edits/' + token + '/' + kind + '/[^/]+$'));
    }

    // The Missionary fields (src/types.ts) minus id, which is the edit's missionaryId.
    function validProposed(p, token) {
      return p is map
        && p.keys().hasOnly(['name', 'lastName', 'organization', 'continent', 'location', 'profileImage',
                             'description', 'prayerLetter', 'media', 'contactInfo', 'specialNotes',
                             'startDate', 'missionType'])
        && reqStr(p.name, 200) && reqStr(p.lastName, 100) && str(p.organization, 200)
        && p.continent in ['north-america', 'central-america', 'south-america', 'europe', 'africa', 'asia', 'oceania']
        && validLocation(p.location)
        && editFile(p.get('profileImage', ''), token, 'profile', 'images')
        && editFile(p.get('prayerLetter', ''), token, 'prayer-letter', 'pdfs')
        && reqStr(p.description, 5000)
        && p.media is list && p.media.size() <= 50
        && p.contactInfo is list && p.contactInfo.size() <= 10
        && str(p.get('specialNotes', ''), 3000) && str(p.get('startDate', ''), 10)
        && str(p.missionType, 200);
    }

    function editable(e) { return e.revoked == false && e.status != 'approved'; }

    match /missionaryEdits/{token} {
      allow get: if isAdmin() || editable(resource.data);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        editable(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposed', 'status', 'updatedAt', 'submittedAt'])
        && request.resource.data.status in ['draft', 'submitted']
        && validProposed(request.resource.data.proposed, token)
        && request.resource.data.updatedAt == request.time
        // Submitting stamps submittedAt; it never changes otherwise.
        && (request.resource.data.status == 'submitted' && resource.data.status != 'submitted'
            ? request.resource.data.submittedAt == request.time
            : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['submittedAt']))
      );
    }

    // Snapshots of a published page taken before each approved edit, so it can be reverted.
    match /missionaryHistory/{missionaryId}/versions/{versionId} {
      allow read, write: if isAdmin();
    }

    // ── Missionary page requests (public form on the home page) ──────────────
    function validPublicContact(c) {
      return c is map
        && c.keys().hasOnly(['email', 'phone', 'website', 'facebook', 'instagram'])
        && str(c.email, 200) && str(c.phone, 40) && str(c.website, 300)
        && str(c.facebook, 300) && str(c.instagram, 300);
    }

    function validMissionaryRequest(d) {
      return d.keys().hasOnly(['language', 'name', 'lastName', 'wifeName', 'email', 'phone',
                               'organization', 'sendingChurch', 'missionType', 'startYear',
                               'continent', 'city', 'state', 'country', 'description', 'prayerRequests',
                               'contact', 'status', 'createdAt'])
        && d.language in ['es', 'en']
        && reqStr(d.name, 100) && reqStr(d.lastName, 100) && str(d.wifeName, 100)
        && reqStr(d.email, 200) && reqStr(d.phone, 40)
        && reqStr(d.organization, 200) && reqStr(d.sendingChurch, 200)
        && str(d.missionType, 200) && str(d.startYear, 4)
        && d.continent in ['north-america', 'central-america', 'south-america', 'europe', 'africa', 'asia', 'oceania']
        && reqStr(d.city, 200) && str(d.state, 200) && reqStr(d.country, 200)
        && reqStr(d.description, 5000) && str(d.prayerRequests, 3000)
        && validPublicContact(d.contact)
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    match /missionaryRequests/{id} {
      allow create: if validMissionaryRequest(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ── Conference registrations ─────────────────────────────────────────────
    // Keep the deadline in sync with REGISTRATION_CLOSES_AT in src/Registration/conference.ts.
    // 1793397600000 = 2026-10-30 17:00 CDT
    function registrationOpen() { return request.time < timestamp.value(1793397600000); }

    function validAddress(a) {
      return a is map
        && a.keys().hasOnly(['street', 'city', 'state', 'zip', 'country'])
        && str(a.get('street', ''), 200) && str(a.get('city', ''), 200) && str(a.get('state', ''), 200)
        && str(a.get('zip', ''), 20) && str(a.get('country', ''), 200);
    }

    function validContact(p) {
      return reqStr(p.firstName, 200) && reqStr(p.lastName, 200) && str(p.email, 200) && str(p.phone, 40);
    }

    function validRegistrant(p) {
      return p is map
        && p.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'address'])
        && validContact(p) && p.email.size() > 0 && p.phone.size() > 0
        && validAddress(p.address);
    }

    function validWife(w) {
      return w is map && w.keys().hasOnly(['firstName', 'lastName', 'email', 'phone']) && validContact(w);
    }

    function validChildren(c) {
      return c is map
        && c.keys().hasOnly(['count', 'infants', 'ages', 'notes'])
        && c.count is int && c.count >= 1 && c.count <= 20
        && c.infants is int && c.infants >= 0 && c.infants <= c.count
        && str(c.ages, 200) && str(c.notes, 1000);
    }

    // Pickups need the transport mode, its details, and the arrival time; people who don't need a pickup
    // may be arriving by RV and have no transport details.
    function validPickup(t) {
      return t.arrivalTime.size() > 0 && t.arrivingByRV == false
        && (t.transport == 'plane' ? t.airline.size() > 0 && t.flightNumber.size() > 0 && t.airport.size() > 0
          : t.transport == 'bus' ? t.busCompany.size() > 0 && t.busStation.size() > 0
          : t.transport == 'other' && t.transportDetails.size() > 0 && t.pickupLocation.size() > 0);
    }

    function validTravel(t) {
      return t is map
        && t.keys().hasOnly(['needsPickup', 'transport', 'airline', 'flightNumber', 'airport', 'busCompany', 'busStation',
                             'transportDetails', 'pickupLocation', 'arrivalDate', 'arrivalTime',
                             'departureDate', 'arrivingByRV', 'notes'])
        && t.needsPickup is bool && t.arrivingByRV is bool
        && t.transport in ['', 'plane', 'bus', 'other']
        && str(t.airline, 200) && str(t.flightNumber, 20) && str(t.airport, 200)
        && str(t.busCompany, 200) && str(t.busStation, 200)
        && str(t.transportDetails, 500) && str(t.pickupLocation, 300)
        && reqStr(t.arrivalDate, 10) && str(t.arrivalTime, 5) && str(t.departureDate, 10)
        && str(t.notes, 1000)
        && (t.needsPickup ? validPickup(t) : t.transport == '');
    }

    // A room sleeps four; infants under 2 share with their parents and don't count.
    function occupants(d) {
      return (d.bringingWife ? 2 : 1)
        + (d.bringingChildren ? d.children.count - d.children.infants : 0);
    }

    // Per ROOM per day — a man and his wife share one room. Free for missionaries,
    // evangelists, and anyone with their own lodging. Laymen pay $80, everyone else the $40
    // discount. Must match calculateHotelFee / hotelRateFor in src/Registration/conference.ts.
    function hotelRate(d) { return d.category == 'layman' ? 80 : 40; }

    function hotelFee(d, rate) {
      return d.category in ['missionary', 'evangelist'] || !d.needsLodging
        ? 0 : rate * d.attendanceDays.size() * int(math.ceil(occupants(d) / 4.0));
    }

    function registrationKeys() {
      return ['language', 'category', 'registrant', 'homeChurch', 'homeChurchCity',
              'missionaryBoard', 'sendingChurch', 'bringingWife', 'wife',
              'bringingChildren', 'children', 'attendanceDays', 'needsLodging', 'travel',
              'heardAbout', 'heardAboutOther', 'specialNeeds', 'hotelFee', 'createdAt'];
    }

    // The fields themselves; create and update add their own key and timestamp checks.
    function validRegistration(d) {
      return d.language in ['es', 'en']
        && d.category in ['missionary', 'evangelist', 'pastor', 'layman']
        && validRegistrant(d.registrant)
        && reqStr(d.homeChurch, 200) && reqStr(d.homeChurchCity, 200)
        && str(d.missionaryBoard, 200) && str(d.sendingChurch, 200)
        && (d.category != 'missionary' || (d.missionaryBoard.size() > 0 && d.sendingChurch.size() > 0))
        && d.bringingWife is bool
        && (d.bringingWife ? validWife(d.wife) : d.wife == null)
        && d.bringingChildren is bool
        && (d.bringingChildren ? validChildren(d.children) : d.children == null)
        && d.attendanceDays is list && d.attendanceDays.size() >= 1 && d.attendanceDays.size() <= 4
        && d.attendanceDays.hasOnly(['2026-11-02', '2026-11-03', '2026-11-04', '2026-11-05'])
        && d.needsLodging is bool
        && validTravel(d.travel)
        && d.heardAbout in ['pastor', 'missionary', 'friend', 'social', 'website', 'attended', 'other']
        && str(d.heardAboutOther, 200) && (d.heardAbout != 'other' || d.heardAboutOther.size() > 0)
        && str(d.specialNeeds, 2000)
        && d.hotelFee == hotelFee(d, hotelRate(d));
    }

    match /registrations/{id} {
      allow create: if registrationOpen()
        && request.resource.data.keys().hasOnly(registrationKeys())
        && validRegistration(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      // Admins can correct a registration at any time, even after the deadline. The fields are
      // checked as on create; createdAt can't change and updatedAt records the edit.
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(registrationKeys().concat(['updatedAt']))
        && validRegistration(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }
  }
}
